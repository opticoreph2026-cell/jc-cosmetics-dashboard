generator client {
  provider = "prisma-client"
  output   = "../lib/prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Channel {
  WEB
  FACEBOOK_POST
  FACEBOOK_MARKETPLACE
  PHYSICAL
}

enum PaymentMethod {
  CASH
  GCASH
  MAYA
  BANK_TRANSFER
  CARD_ONLINE
  CARD_OTC
}

enum ProcurementStatus {
  PENDING
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum AdminRole {
  ADMIN
}

enum ExpenseCategory {
  RENT
  SALARIES
  UTILITIES
  PACKAGING
  FREIGHT
  SHIPPING
  MARKETING
  MAINTENANCE
  EQUIPMENT
  SOFTWARE
  PROFESSIONAL_FEES
  TAXES
  INSURANCE
  OTHER
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      AdminRole @default(ADMIN)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@map("categories")
}

model Product {
  id          String           @id @default(cuid())
  name        String
  description String?
  categoryId  String           @map("category_id")
  category    Category         @relation(fields: [categoryId], references: [id])
  imageUrl    String?          @map("image_url")
  attributes  Json?            @default("{}")
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  variants    ProductVariant[]

  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id                String            @id @default(cuid())
  productId         String            @map("product_id")
  product           Product           @relation(fields: [productId], references: [id])
  name              String
  sku               String            @unique
  barcode           String?
  unitCost          Decimal           @map("unit_cost") @db.Decimal(10, 2)
  sellingPrice      Decimal           @map("selling_price") @db.Decimal(10, 2)
  currentStockQty   Int               @default(0) @map("current_stock_qty")
  reorderPoint      Int               @default(0) @map("reorder_point")
  attributes        Json?             @default("{}")
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  salesOrderItems   SalesOrderItem[]
  ledgerEntries     InventoryLedger[]
  supplierProducts  SupplierProduct[]
  procurementItems  ProcurementItem[]
  stockAudits       StockAudit[]

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model Supplier {
  id              String            @id @default(cuid())
  name            String
  contactPerson   String?           @map("contact_person")
  email           String?
  phone           String?
  address         String?
  notes           String?
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  supplierProducts SupplierProduct[]
  procurements    Procurement[]
  accountPayables AccountPayable[]

  @@map("suppliers")
}

model SupplierProduct {
  id           String          @id @default(cuid())
  supplierId   String          @map("supplier_id")
  supplier     Supplier        @relation(fields: [supplierId], references: [id])
  variantId    String          @map("variant_id")
  variant      ProductVariant  @relation(fields: [variantId], references: [id])
  unitCost     Decimal         @map("unit_cost") @db.Decimal(10, 2)
  leadTimeDays Int?            @map("lead_time_days")
  isPreferred  Boolean         @default(false) @map("is_preferred")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@unique([supplierId, variantId])
  @@index([supplierId])
  @@index([variantId])
  @@map("supplier_products")
}

model SalesOrder {
  id            String            @id @default(cuid())
  orderNumber   String            @unique @map("order_number")
  channel       Channel
  customerId    String?           @map("customer_id")
  customer      Customer?         @relation(fields: [customerId], references: [id])
  paymentMethod PaymentMethod     @map("payment_method")
  subtotal      Decimal           @db.Decimal(10, 2)
  discount      Decimal           @default(0) @db.Decimal(10, 2)
  total         Decimal           @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  items         SalesOrderItem[]
  receivables   AccountReceivable[]

  @@index([customerId])
  @@index([channel])
  @@index([createdAt])
  @@map("sales_orders")
}

model SalesOrderItem {
  id              String         @id @default(cuid())
  salesOrderId    String         @map("sales_order_id")
  salesOrder      SalesOrder     @relation(fields: [salesOrderId], references: [id])
  variantId       String         @map("variant_id")
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  qty             Int
  unitPriceAtSale Decimal        @map("unit_price_at_sale") @db.Decimal(10, 2)
  unitCostAtSale  Decimal        @map("unit_cost_at_sale") @db.Decimal(10, 2)
  subtotal        Decimal        @db.Decimal(10, 2)
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([salesOrderId])
  @@index([variantId])
  @@map("sales_order_items")
}

model InventoryLedger {
  id               String         @id @default(cuid())
  variantId        String         @map("variant_id")
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  changeQty        Int            @map("change_qty")
  channel          Channel
  referenceId      String?        @map("reference_id")
  referenceType    String?        @map("reference_type")
  note             String?
  previousStockQty Int            @map("previous_stock_qty")
  newStockQty      Int            @map("new_stock_qty")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([variantId])
  @@index([referenceId])
  @@index([createdAt])
  @@map("inventory_ledger")
}

model Customer {
  id                 String                    @id @default(cuid())
  name               String
  email              String?
  phone              String?
  notes              String?
  totalLifetimeSpend  Decimal                   @default(0) @map("total_lifetime_spend") @db.Decimal(12, 2)
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  channelIdentities  CustomerChannelIdentity[]
  salesOrders        SalesOrder[]
  receivables        AccountReceivable[]

  @@index([phone])
  @@index([email])
  @@map("customers")
}

model CustomerChannelIdentity {
  id                String   @id @default(cuid())
  customerId        String   @map("customer_id")
  customer          Customer @relation(fields: [customerId], references: [id])
  channel           Channel
  channelCustomerId String   @map("channel_customer_id")
  phone             String?
  email             String?
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([channel, channelCustomerId])
  @@index([customerId])
  @@index([phone])
  @@map("customer_channel_identities")
}

model Procurement {
  id           String            @id @default(cuid())
  poNumber     String            @unique @map("po_number")
  supplierId   String            @map("supplier_id")
  supplier     Supplier          @relation(fields: [supplierId], references: [id])
  status       ProcurementStatus @default(PENDING)
  orderDate    DateTime          @default(now()) @map("order_date")
  receivedDate DateTime?         @map("received_date")
  notes        String?
  totalCost    Decimal           @db.Decimal(12, 2) @map("total_cost")
  freightCost  Decimal?          @map("freight_cost") @db.Decimal(10, 2)
  otherCost    Decimal?          @map("other_cost") @db.Decimal(10, 2)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  items        ProcurementItem[]
  payables     AccountPayable[]

  @@index([supplierId])
  @@index([status])
  @@map("procurements")
}

model ProcurementItem {
  id             String         @id @default(cuid())
  procurementId  String         @map("procurement_id")
  procurement    Procurement   @relation(fields: [procurementId], references: [id])
  variantId      String         @map("variant_id")
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  qtyOrdered     Int            @map("qty_ordered")
  qtyReceived    Int            @default(0) @map("qty_received")
  unitCost       Decimal        @map("unit_cost") @db.Decimal(10, 2)
  subtotal       Decimal        @db.Decimal(12, 2)
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([procurementId])
  @@index([variantId])
  @@map("procurement_items")
}

model Expense {
  id          String          @id @default(cuid())
  description String
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime
  notes       String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([date])
  @@index([category])
  @@map("expenses")
}

model SalesTarget {
  id        String   @id @default(cuid())
  month     Int
  year      Int
  channel   Channel
  target    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([month, year, channel])
  @@map("sales_targets")
}

model StockAudit {
  id            String         @id @default(cuid())
  variantId     String         @map("variant_id")
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  expectedQty   Int            @map("expected_qty")
  actualQty     Int            @map("actual_qty")
  variance      Int
  notes         String?
  conductedAt   DateTime       @default(now()) @map("conducted_at")

  @@index([variantId])
  @@index([conductedAt])
  @@map("stock_audits")
}

model AccountReceivable {
  id           String     @id @default(cuid())
  customerId   String     @map("customer_id")
  customer     Customer   @relation(fields: [customerId], references: [id])
  salesOrderId String?    @map("sales_order_id")
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])
  amount       Decimal    @db.Decimal(12, 2)
  paidAmount   Decimal    @default(0) @db.Decimal(12, 2)
  dueDate      DateTime?  @map("due_date")
  status       String     @default("UNPAID")
  notes        String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([status])
  @@map("accounts_receivable")
}

model AccountPayable {
  id            String      @id @default(cuid())
  supplierId    String      @map("supplier_id")
  supplier      Supplier    @relation(fields: [supplierId], references: [id])
  procurementId String?     @map("procurement_id")
  procurement   Procurement? @relation(fields: [procurementId], references: [id])
  amount        Decimal     @db.Decimal(12, 2)
  paidAmount    Decimal     @default(0) @db.Decimal(12, 2)
  dueDate       DateTime?   @map("due_date")
  status        String      @default("UNPAID")
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([supplierId])
  @@index([status])
  @@map("accounts_payable")
}
